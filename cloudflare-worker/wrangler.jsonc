{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secure-task-manager-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secure-task-manager-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
